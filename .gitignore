# =============================================================================
# Data Analysis Agent - files that must not be committed
# =============================================================================

# --- Secrets and local configuration -----------------------------------------
# Keep .env.example in Git, but never commit real environment files.
.env
.env.*
!.env.example
*.env
secrets/
.secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
service-account*.json
credentials*.json

# --- User data and generated analysis artifacts ------------------------------
# Uploaded datasets may contain private/business data. Keep only placeholders.
data/**
!data/.gitkeep
!data/**/
!data/**/.gitkeep

# Generated reports, charts, exports, and temporary analysis results.
outputs/**
!outputs/.gitkeep
!outputs/**/
!outputs/**/.gitkeep
reports/
exports/
artifacts/

# Generated test fixtures and reports (source test code remains tracked).
tests/day3_output/
tests/day3_llm_output/
tests/**/outputs/
tests/**/reports/

# Local backup/snapshot directories.
backup*/
backups/
README_DAY45.md
*.bak
*.backup
*.orig
*.tmp
*.temp
*~

# --- Logs, runtime state, and local databases --------------------------------
*.log
logs/
*.pid
*.pid.lock
*.seed
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal

